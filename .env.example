TELEGRAM_BOT_TOKEN=
# Telegram ID администраторов через запятую (узнать: @userinfobot)
ADMIN_TG_IDS=
GREEN_API_URL=https://api.green-api.com
# Хост для отправки файлов из личного кабинета Green API (mediaUrl); пусто = GREEN_API_URL
GREEN_API_MEDIA_URL=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
POSTGRES_PASSWORD=changeme
# Для локального запуска; в Docker Compose переопределяется
DATABASE_URL=postgresql+asyncpg://helpdesk:changeme@localhost:5432/helpdesk
TZ=Asia/Almaty
REMIND_AFTER_MIN=10
# Час (по TZ), в который приходят напоминания о сроках задач
TASK_REMIND_HOUR=9
FILES_DIR=/data/files
# Распознавание голосовых (локальный Whisper). Модель small — нужно от 4 ГБ RAM.
# base — слабее и быстрее, medium — лучше для казахского, но медленнее (~2.5 ГБ).
STT_ENABLED=true
STT_MODEL=small
# Голосовые длиннее (секунд) не распознаются
STT_MAX_SECONDS=120
